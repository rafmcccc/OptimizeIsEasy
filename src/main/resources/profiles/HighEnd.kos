#
# OptimizeIsEasy first-party KOS profile.
# HighEnd: for powerful dedicated machines that can afford distance and density.
#
# Profile format from Kryptonite by LewMC (Apache-2.0).
# Shipped and applied by OptimizeIsEasy ${version}.
#
# How to read this file
#   * Every key is optional. A key that is missing here is never touched.
#   * A key your server version does not have is skipped, never invented.
#   * The literal value 'default' means "leave whatever the server file says".
#   * A whole section is skipped when that server file does not exist, so the same
#     profile is safe on Paper, Purpur, Pufferfish, Gale and Leaf.
#   * Values are tuned for 1.21.x on strong hardware (8+ cores, 12GB+ RAM).
#     If TPS still drops, step down to Balanced.
#

# Profile information
meta:
  description: Generous optimisation for powerful hardware. High view distance, fast farms.
  author: OptimizeIsEasy

# Server Settings - server.properties
server:
  # Compression above this size stops costing CPU for almost no bandwidth gain.
  network-compression-threshold: 256
  distance:
    # 10 chunks looks great and a strong box can afford it. Lower to 8 if MSPT climbs.
    view: 10
    simulation: 6
  # Let chunk writes happen on the chunk's own thread instead of stalling the main thread.
  sync-chunk-writes: false
  allow-flight: true

# CraftBukkit Settings - bukkit.yml
craftbukkit:
  # Hard cap per chunk. Kept high on purpose: this profile assumes headroom.
  spawn-limits:
    monsters: 60
    animals: 10
    axolotls: 5
    ambient: 10
    water:
      animals: 5
      ambient: 10
      underground-creature: 5
  # Ticks between spawn attempts. Monsters try every 2 ticks, everything else is
  # left fast so farms and ambient life feel vanilla.
  ticks-per:
    monsters: 2
    animals: 400
    axolotls: 1
    ambient: 1
    water:
      animals: 1
      ambient: 1
      underground-creature: 1
  # Ticks between full world saves. Higher means fewer save spikes, -1 disables autosave.
  ticks-per.autosave: 6000
  # Paper caps this at 20 ticks, so it only really matters on Spigot.
  chunk-gc-period-in-ticks: 400
  # 'Can't keep up!' spam on every overloaded tick hides the useful lines.
  warn-on-overload: false
  # Milliseconds an IP must wait between connection attempts.
  connection-throttle: 4000
  # Hides your plugin list from ping.
  query-plugins: false
  # One of: true, false, default.
  deprecated-verbose: "false"

# Spigot Settings - spigot.yml
spigot:
  view-distance: default
  simulation-distance: default
  # Chunks around a player where mobs may spawn. 6 keeps spawns lively at view 10.
  mob-spawn-range: 6
  # How far entities tick at full rate. Generous on purpose for a strong box.
  entities:
    activation-range:
      animals: 32
      monsters: 32
      raiders: 64
      misc: 16
      water: 16
      villagers: 32
      flying: 48
    tracking-range:
      players: 128
      animals: 96
      monsters: 96
      misc: 96
      other: 64
    # How often sleeping entities outside their activation range are woken back up.
    wake-up-inactive:
      animals:
        every: 1200
        max-per-tick: 4
      monsters:
        every: 400
        max-per-tick: 8
      villagers:
        every: 600
        max-per-tick: 4
      flying-monsters:
        every: 200
        max-per-tick: 8
    tick-inactive-villagers: true
    spawner-mobs-nerfed: false
  hopper:
    # Ticks between one item move and one hopper scan.
    transfer: 8
    check: 8
  # Three items per slot moves farm output noticeably faster.
  hopper.amount: 3
  # A hopper pulling from an unloaded chunk is a cheap way to load the world.
  hopper.can-load-chunks: false
  # Ticks a TNT is processed per tick, 100 is the vanilla/Paper default.
  max-tnt-per-tick: 100
  # Ground items vanish at the vanilla 6000 ticks so unattended drops stay collectable.
  item-despawn-rate: 6000
  # Vanilla is 1200 (60s). Still short enough that arrows never pile up.
  arrow-despawn-rate: 600
  trident-despawn-rate: 600
  # Chance of a lightning strike is 1/thunder-chance per chunk, higher is rarer.
  thunder-chance: 100000
  # true keeps vanilla zombie behaviour towards your villagers.
  zombie-aggressive-towards-villager: true
  # Larger merge radius means item and xp orbs combine sooner, so fewer entities.
  merge-radius:
    item: 2.5
    exp: 4.0
  # Random growth speed, 100 is vanilla. 200 is a faster farm, not a cheaper tick.
  growth:
    cane: 200
    wheat: 200
    carrot: 200
    potato: 200
    beetroot: 200
    melon: 200
    pumpkin: 200
    bamboo: 200
    kelp: 200

# Paper Settings - config/paper-world-defaults.yml
paper:
  chunks:
    # Seconds a chunk stays loaded after its last player leaves. Longer means
    # fewer chunk loads on walk-backs, at the cost of RAM.
    delay-unloads: 10
    max-autosave-per-tick: 16
    prevent-moving-into-unloaded: true
    # Projectiles per chunk that get saved. Caps the classic 'shoot and leave' lag.
    entity-save-limit:
      area-effect-cloud: 8
      arrow: 16
      dragon-fireball: 3
      egg: 8
      ender-pearl: 8
      experience-bottle: 3
      experience-orb: 16
      eye-of-ender: 8
      fireball: 8
      llama-spit: 3
      potion: 8
      shulker-bullet: 8
      small-fireball: 8
      snowball: 8
      spectral-arrow: 16
      trident: 16
      wither-skull: 4
  despawn-ranges:
    ambient:
      hard: 128
      soft: 48
    axolotl:
      hard: 128
      soft: 48
    creature:
      hard: 128
      soft: 48
    misc:
      hard: 128
      soft: 48
    monster:
      hard: 128
      soft: 48
    water:
      underground-creature:
        hard: 128
        soft: 48
      ambient:
        hard: 128
        soft: 48
      creature:
        hard: 128
        soft: 48
  despawn-time:
    llama-spit: 1200
    snowball: 1200
    fireball: 1200
    dragon-fireball: 1200
    small-fireball: 1200
    arrow: 3000
    shulker-bullet: 3000
    wither-skull: 3000
    trident: 3000
  per-player-mob-spawns: true
  # Vanilla is 8. 6 keeps collisions calm without slowing stacked farms much.
  max-entity-collisions: 6
  update-pathfinding-on-block-update: false
  fix-climbing-bypass-cramming-rule: true
  armor-stands:
    tick: false
    do-collision-entity-lookups: false
  nerfed-spawner-mobs-can-jump: false
  # Lower means the check runs less often, in ticks. -1 and 40 are the values
  # Paper itself ships, so villager behaviour stays the same.
  tick-rates:
    villager:
      behaviour:
        nearby-poi: -1
        acquire-poi: -1
      sensor:
        secondary-poi: 40
        nearest-bed: 40
        villager-babies: 40
        player: 40
        nearest-living-entity: 40
    mob-spawner: 1
    grass-spread: 4
    container-update: 2
  optimised-despawn:
    enabled: true
    # Dropped items in these blocks are removed after this many ticks, so a
    # destroyed build does not leave a field of items behind.
    cobblestone: 300
    netherrack: 300
    sand: 300
    red-sand: 300
    gravel: 300
    dirt: 300
    short-grass: 300
    pumpkin: 300
    melon-slice: 300
    kelp: 300
    bamboo: 300
    sugar-cane: 300
    twisting-vines: 300
    weeping-vines: 300
    oak-leaves: 300
    spruce-leaves: 300
    birch-leaves: 300
    jungle-leaves: 300
    acacia-leaves: 300
    dark-oak-leaves: 300
    mangrove-leaves: 300
    cactus: 300
    diorite: 300
    granite: 300
    andesite: 300
    scaffolding: 300
    arrow:
      non-player: 20
      creative: 20
  redstone-implementation: ALTERNATE_CURRENT
  hoppers:
    ignore-occluding-blocks: true
  optimise-explosions: true
  # true keeps the lookup caches warm, which is the cheaper option on a server
  # where villagers trade often.
  find-already-discovered-loot-tables: true
  find-already-discovered-villager-trade: true
  xp-orb-groups-per-area: 40
  environment:
    # false keeps vanilla storms. Lobbies and anarchy boxes set these true.
    disable-thunder: false
    disable-ice-and-snow: false
    # Minimum delay between fire ticks. Higher saves tick time on big fires.
    fire-tick-delay: 30
    # Blocks searched for an existing nether portal before making a new one.
    portal-search-radius: 128
    # Safety caps per tick. Lower these to blunt block-update lag machines.
    max-block-ticks: 65536
    max-fluid-ticks: 65536
  collisions:
    # true means only players collide with each other, entities pass through.
    only-players-collide: false
  maps:
    # Cursors per map. Lower this if map walls are used for client lag.
    item-frame-cursor-limit: 128
  entities:
    # false skips the one-time scan for a pre-1.0 ender dragon on boot.
    scan-for-legacy-ender-dragon: false
  anticheat:
    # Paper anti-xray. Enable with engine-mode 2 on anarchy servers.
    enabled: false
    engine-mode: 1
  misc:
    # Light engine work queue. Raise on huge view distances if lighting lags.
    light-queue-size: 20

# Paper Global Settings - config/paper-global.yml
paper-global:
  chunk-system:
    # -1 lets Paper size the thread pools from your CPU cores. Only set a real
    # number if you have measured it.
    io-threads: -1
    worker-threads: -1
  chunk-loading:
    # A strong box can serve several chunk jobs per player at once.
    player-max-concurrent-chunk-generates: 4
    player-max-concurrent-chunk-loads: 8
  player-auto-save:
    # -1 follows bukkit.yml ticks-per.autosave above, so the two never disagree.
    rate: -1
    max-per-tick: 20
  # Login plugins often leave empty scoreboard teams behind, which slows logins down.
  scoreboards:
    save-empty-scoreboard-teams: true
  collisions:
    # false disables player-to-player pushing. Keep true unless it lags.
    enable-player-collisions: true
  timings:
    # The built-in profiler. Off saves a little overhead on every event.
    enabled: false
  spam-limiter:
    # Counter increments per tab/recipe press before the spam limit kicks in.
    recipe-spam-increment: 1
    tab-spam-increment: 1
  item-validation:
    # Max bytes a single book page may contribute. 1024 matches the ExploitDB cap.
    book-page-max: 2560
    display-name: 8192
    lore-line: 8192
  packet-limiter:
    # Global flood guard. Stricter values belong on lobby and anarchy profiles.
    max-packet-rate: 500.0
    interval: 7.0
  watchdog:
    # Milliseconds before the watchdog starts dumping threads on a hang.
    early-warning-delay: 10000
    early-warning-every: 5000
  misc:
    # Keeps client and server entity positions in agreement. Fixes MC-4 style desync.
    fix-entity-position-desync: true
  console:
    # Brigadier highlighting costs console formatting on every command.
    enable-brigadier-highlighting: true
  # Exploit switches. false everywhere closes them, same fixes as the ExploitDB module.
  unsupported-settings:
    allow-headless-pistons: false
    allow-permanent-block-break-exploits: false
    allow-piston-duplication: false
    allow-unsafe-end-portal-teleportation: false

# Purpur Settings - purpur.yml
purpur:
  entities:
    all:
      can-use-portals: false
    zombie:
      aggressive-towards-villager-when-lagging: false
    villager:
      # Lobotomising is off so villagers keep restocking and breeding.
      lobotomized: false
      search-radius:
        acquire-poi: 18
        nearest-bed-sensor: 18
    # Shared RNG across entities of the same type. Cheaper and behaviour-neutral.
    shared-random: true
  # Catch up missed ticks after lag instead of skipping them. Off avoids spike cascades.
  tps-catchup: true
  use-alternative-keepalive: true
  teleport-if-outside-worldborder: true
  # Purpur treats the server as lagging below this and throttles its own features.
  lagging-tps-threshold: 19.0
  gameplay-mechanics:
    elytra:
      # Kinetic elytra damage is a per-tick velocity calculation for every gliding player.
      kinetic-damage: false
  mobs:
    phantom:
      spawn:
        # Higher than the strict profiles, a strong box can afford night phantoms.
        per-attempt:
          max: 4

# Pufferfish Settings - pufferfish.yml
pufferfish:
  max-loads-per-projectile: 8
  # Per-tick counterpart of the cap above. Skipped when your build lacks the key.
  max-loads-per-tick: 8
  entities:
    dynamic-activation-of-brain:
      enabled: true
      max-tick-freq: 20
      activation-distance-modifier: 7
    async-mob-spawning: true
    suffocation-optimisation: true
    inactive-goal-selector-throttle: true
  disable-method-profiler: true

# Gale Settings - config/gale-global.yml (Leaf ships this too, Leaf is built on Gale)
gale:
  # Console noise that is harmless on an updated server. Turning it off keeps
  # latest.log readable and saves the string formatting behind it.
  log-to-console:
    chat:
      empty-message-warning: false
      expired-message-warning: false
    ignored-advancements: false
    invalid-pool-element-error-log-level: none
    invalid-statistics: false
    legacy-material-initialization: false
    set-block-in-far-chunk: false
    unrecognized-recipes: false
  misc:
    # Unparsable legacy structure NBT throws an exception per hit without this.
    ignore-null-legacy-structure-data: true
    keepalive:
      send-multiple: true
  small-optimizations:
    # Ticks between the two interval-limited bookkeeping tasks. Vanilla is 1,
    # nobody can tell the difference.
    reduced-intervals:
      increase-time-statistics: 100
      update-entity-line-of-sight: 10
    # Cheaper entity tracker. Skipped when your Gale/Leaf build lacks the key.
    optimized-tracker:
      enabled: true

# Leaf Settings - config/leaf-global.yml
# Thread counts are left at 0 on purpose: Leaf sizes those pools from your CPU
# cores, so the same profile is correct on a VPS and on a dedicated box.
leaf:
  async:
    async-entity-tracker:
      enabled: true
      # Only needed for real-entity NPC plugins such as Citizens.
      compat-mode: false
      max-threads: 0
      keepalive: 60
    async-pathfinding:
      enabled: true
      max-threads: 0
      keepalive: 60
      queue-size: 0
      reject-policy: CALLER_RUNS
    async-target-finding:
      enabled: true
    async-mob-spawning:
      enabled: true
    async-locator:
      enabled: true
      threads: 0
      keepalive: 60
    async-chunk-send:
      enabled: true
      # 0 lets Leaf size the send pool from your CPU cores.
      threads: 0
      keepalive: 60
  performance:
    # Leaf 26.x collapsed the three use-virtual-thread-for-* keys into this one.
    use-virtual-thread: true
    use-virtual-thread-for-async-chat-executor: true
    use-virtual-thread-for-async-scheduler: true
    use-virtual-thread-for-user-authenticator: true
    # Mob goal selectors re-run once a second while the mob is inactive.
    inactive-goal-selector-throttle: true
    skip-ai-for-non-aware-mob: true
    optimized-powered-rails: true
    # Retry a full hopper every 8 ticks instead of every tick.
    throttle-hopper-when-full:
      enabled: true
      skip-ticks: 8
    optimize-minecart:
      enabled: true
      skip-tick-count: 30
    dab:
      enabled: true
      max-tick-freq: 20
      start-distance: 12
      activation-dist-mod: 7
  misc:
    secure-seed:
      # Stays off so slime chunks, villages and existing builds are unchanged.
      enabled: false
