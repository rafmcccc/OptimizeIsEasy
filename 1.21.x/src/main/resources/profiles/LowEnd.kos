#
# OptimizeIsEasy first-party profile.
# LowEnd: aggressive tuning for weak hardware or very busy servers.
#

# Profile information
meta:
  description: Aggressive optimisation for weak hardware. Tight view, spawn and tick ranges.
  author: OptimizeIsEasy

# Server Settings
server:
  network-compression-threshold: 256
  distance:
    view: 6
    simulation: 3
  sync-chunk-writes: false
  allow-flight: true

# CraftBukkit Settings
craftbukkit:
  spawn-limits:
    monsters: 15
    animals: 4
    axolotls: 2
    ambient: 1
    water:
      animals: 2
      ambient: 2
      underground-creature: 2
  ticks-per:
    monsters: 20
    animals: 400
    axolotls: 400
    ambient: 400
    water:
      animals: 400
      ambient: 400
      underground-creature: 400
  chunk-gc-period-in-ticks: 400

# Spigot Settings
spigot:
  view-distance: default
  mob-spawn-range: 2
  entities:
    activation-range:
      animals: 12
      monsters: 16
      raiders: 32
      misc: 6
      water: 6
      villagers: 12
      flying: 24
    tracking-range:
      players: 32
      animals: 32
      monsters: 32
      misc: 24
      other: 48
    tick-inactive-villagers: false
    spawner-mobs-nerfed: true
  hopper:
    transfer: 8
    check: 8

# Paper Settings
paper:
  chunks:
    delay-unloads: 10
    max-autosave-per-tick: 8
    prevent-moving-into-unloaded: true
    entity-save-limit:
      area-effect-cloud: 8
      arrow: 16
      dragon-fireball: 3
      egg: 8
      ender-pearl: 8
      experience-bottle: 3
      experience-orb: 16
      eye-of-ender: 8
      fireball: 8
      llama-spit: 3
      potion: 8
      shulker-bullet: 8
      small-fireball: 8
      snowball: 8
      spectral-arrow: 16
      trident: 16
      wither-skull: 4
  despawn-ranges:
    ambient:
      hard: 64
      soft: 24
    axolotl:
      hard: 64
      soft: 24
    creature:
      hard: 64
      soft: 24
    misc:
      hard: 64
      soft: 24
    monster:
      hard: 64
      soft: 24
    water:
      underground-creature:
        hard: 64
        soft: 24
      ambient:
        hard: 64
        soft: 24
      creature:
        hard: 64
        soft: 24
  despawn-time:
    llama-spit: 1200
    snowball: 1200
    fireball: 1200
    dragon-fireball: 1200
    small-fireball: 1200
    arrow: 3000
    shulker-bullet: 3000
    wither-skull: 3000
    trident: 3000
  per-player-mob-spawns: true
  max-entity-collisions: 2
  update-pathfinding-on-block-update: false
  fix-climbing-bypass-cramming-rule: true
  armor-stands:
    tick: false
    do-collision-entity-lookups: false
  nerfed-spawner-mobs-can-jump: false
  tick-rates:
    villager:
      behaviour:
        nearby-poi: 90
        acquire-poi: 180
      sensor:
        secondary-poi: 100
        nearest-bed: 100
        villager-babies: 60
        player: 60
        nearest-living-entity: 60
    mob-spawner: 3
    grass-spread: 6
    container-update: 3
  optimised-despawn:
    enabled: true
    cobblestone: 200
    netherrack: 200
    sand: 200
    red-sand: 200
    gravel: 200
    dirt: 200
    short-grass: 200
    pumpkin: 200
    melon-slice: 200
    kelp: 200
    bamboo: 200
    sugar-cane: 200
    twisting-vines: 200
    weeping-vines: 200
    oak-leaves: 200
    spruce-leaves: 200
    birch-leaves: 200
    jungle-leaves: 200
    acacia-leaves: 200
    dark-oak-leaves: 200
    mangrove-leaves: 200
    cactus: 200
    diorite: 200
    granite: 200
    andesite: 200
    scaffolding: 200
    arrow:
      non-player: 20
      creative: 20
  redstone-implementation: ALTERNATE_CURRENT
  hoppers:
    ignore-occluding-blocks: true
  optimise-explosions: true
  find-already-discovered-loot-tables: false
  find-already-discovered-villager-trade: false
  xp-orb-groups-per-area: 40

# Purpur Settings
purpur:
  entities:
    all:
      can-use-portals: false
    zombie:
      aggressive-towards-villager-when-lagging: false
    villager:
      lobotomized: false
      search-radius:
        acquire-poi: 12
        nearest-bed-sensor: 12
  use-alternative-keepalive: true
  teleport-if-outside-worldborder: true
  lagging-tps-threshold: 19.0

# Pufferfish Settings
pufferfish:
  max-loads-per-projectile: 8
  entities:
    dynamic-activation-of-brain:
      enabled: true
      max-tick-freq: 30
      activation-distance-modifier: 8
    async-mob-spawning: true
    suffocation-optimisation: true
    inactive-goal-selector-throttle: true
  disable-method-profiler: true
